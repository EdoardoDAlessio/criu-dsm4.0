########## PATHS ##########

# Location of the source benchmark
APP_SOURCE_DIR="$HOME/phoenix/phoenix-2.0/tests/linear_regression"

# Executable (must exist inside APP_SOURCE_DIR)
APP_EXEC="linear_regression-dsm"

########## RUN PARAMS ##########

# Arguments passed to the binary
APP_ARGS="/dev/shm/key_file_40000MB.txt"

# Additional input files required for correct execution (optional)
APP_EXTRA_FILES=()   # word_count-dsm doesn't need extra files

# Warm up time before CRIU dump
APP_WARMUP=3

########## CLIENT MACHINES ##########
CLIENTS=("dsm_client" "dsm_client2" "dsm_client3")

# Number of threads for DSM (main thread count)
APP_THREADS=8

########## RESTORE / SPLIT CONFIGS ##########
CONFIGS=(
    "base      0   0-7        tcp"
    "4_4_t            1   0-3   4-7          tcp"
    "4_4_r         1    0-3   4-7             rdma"
    "4_2_2_t        2   0-3   4-5   6-7           tcp"
    "4_2_2_r        2   0-3   4-5   6-7         rdma"
    "5_1_1_1_t     3   0-4   5-5   6-6   7-7          tcp"
    "5_1_1_1_r     3   0-4   5-5   6-6   7-7          rdma"
    "2_2_2_2_t      3   0-1   2-3  4-5   6-7          tcp"
    "2_2_2_2_r     3   0-1   2-3  4-5   6-7           rdma"
)

########## SCRIPT PATHS ##########
SCRIPTS="$HOME/criu/dsm/scripts"
THREAD_FILTER="$SCRIPTS/thread_filter_ranged.py"
