########## PATHS ##########

# Location of the source benchmark
APP_SOURCE_DIR="$HOME/phoenix/phoenix-2.0/tests/matrix_multiply"

# Executable (must exist inside APP_SOURCE_DIR)
APP_EXEC="matrix_multiply-dsm"

########## RUN PARAMS ##########

# Arguments passed to the binary
APP_ARGS="6000"

########## EXTRA FILES REQUIRED ##########
APP_EXTRA_FILES=(
    "matrix_file_A.txt"
    "matrix_file_B.txt"
)

# Warm up time before CRIU dump
APP_WARMUP=5

########## CLIENT MACHINES ##########
CLIENTS=("dsm_client")

# Number of threads for DSM (main thread count)
APP_THREADS=64

########## RESTORE / SPLIT CONFIGS ##########
CONFIGS=(
    "base            0-63    -       0   tcp"
    "split16_16_tcp  0-31    32-63   1   tcp"
    "split16_16_rdma 0-31    32-63   1   rdma"
)

########## SCRIPT PATHS ##########
SCRIPTS="$HOME/criu/dsm/scripts"
THREAD_FILTER="$SCRIPTS/thread_filter_ranged.py"
