########## PATHS ##########

# Location of the source benchmark
APP_SOURCE_DIR="$HOME/phoenix/phoenix-2.0/tests/matrix_multiply"

# Executable (must exist inside APP_SOURCE_DIR)
APP_EXEC="matrix_multiply-dsm"

########## RUN PARAMS ##########

# Arguments passed to the binary
APP_ARGS="6000"

########## EXTRA FILES REQUIRED ##########
APP_EXTRA_FILES=(
    "matrix_file_A.txt"
    "matrix_file_B.txt"
)

# Warm up time before CRIU dump
APP_WARMUP=5

########## CLIENT MACHINES ##########
