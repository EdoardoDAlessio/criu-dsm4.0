########## PATHS ##########

# Location of the source benchmark
APP_SOURCE_DIR="$HOME/phoenix/phoenix-2.0/tests/word_count"

# Executable (must exist inside APP_SOURCE_DIR)
APP_EXEC="word_count-dsm"

########## RUN PARAMS ##########

# Arguments passed to the binary
APP_ARGS="$HOME/phoenix/phoenix-2.0/tests/input/word_count_datafiles/word_1600MB.txt 8"

# Additional input files required for correct execution (optional)
APP_EXTRA_FILES=()   # word_count-dsm doesn't need extra files

# Warm up time before CRIU dump
APP_WARMUP=5

########## CLIENT MACHINES ##########
CLIENTS=("dsm_client")

# Number of threads for DSM (main thread count)
APP_THREADS=32

########## RESTORE / SPLIT CONFIGS ##########
CONFIGS=(
    "base            0-31    -       0   tcp"
    "split16_16_tcp  0-15    16-31   1   tcp"
    "split16_16_rdma 0-15    16-31   1   rdma"
)

########## SCRIPT PATHS ##########
SCRIPTS="$HOME/criu/dsm/scripts"
THREAD_FILTER="$SCRIPTS/thread_filter_ranged.py"
